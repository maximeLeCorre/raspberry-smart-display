# Modèle de variables d'environnement — copier vers .env (ignoré par Git).
# Aucune clé n'est nécessaire pour l'instant : la Live Client Data API de Riot
# est locale et ne demande pas de clé. Ce fichier anticipe un futur usage
# (ex. Riot API web pour l'historique, OpenWeather pour la météo).

# Clé Riot (plus tard, NE PAS committer la vraie valeur)
RIOT_API_KEY=

# Clé météo (plus tard)
WEATHER_API_KEY=

# Jeton d'authentification du lien Pi <-> agent (partagé par les deux côtés).
# Protège le serveur WebSocket du Pi : seul un client présentant ce jeton est
# accepté. Vide = authentification DÉSACTIVÉE (le Pi accepte tout le réseau
# local, comportement historique, pratique en test local).
# Mettre une valeur longue et aléatoire, identique côté Pi et côté agent.
DISPLAY_AUTH_TOKEN=

# Déploiement sur le Pi (utilisé par deploy/deploy_pi.py). Le mot de passe reste
# ici (jamais commité), pas dans le script.
PI_HOST=192.168.1.XX
PI_USER=pi
PI_PASS=
# PI_DIR=                 # optionnel (défaut /home/<user>/pi-display)
