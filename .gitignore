# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Environnements virtuels ---
.venv/
venv/
env/
ENV/

# --- Secrets / configuration locale ---
.env

# --- TLS (certificat auto-signé du lien Pi <-> agent) ---
# La clé privée ne doit JAMAIS être committée. Le .crt est public mais on ignore
# tout le dossier par simplicité (le régénérer via tools/gen_cert.py).
certs/

# --- IDE / éditeurs ---
.idea/
.vscode/
*.iml

# --- Système ---
.DS_Store
Thumbs.db

# --- Base locale des parties (Pi) ---
*.db

# --- Journaux de l'agent PC (autostart) ---
logs/

# --- Empreinte SSH du Pi (deploy, TOFU) ---
deploy/known_hosts

# --- Scripts/rendus jetables (préfixe _, exclus aussi du déploiement) ---
pi_display/_*

# App montre : projet généré par XcodeGen (CI uniquement)
watch_app/build/
watch_app/*.xcodeproj/

# App montre : signature TestFlight (clé privée, secret) — watch_app/signing.py
watch_app/signing/

# Sons des kills (montre) : extraits sans licence, JAMAIS dans le dépôt public ;
# copiés sur le Pi par deploy (archive du dossier), servis à la montre.
pi_display/sounds/

# Réglages personnels du Pi (ville, gare, pseudos…) : hors dépôt public
pi_display/config.local.toml
